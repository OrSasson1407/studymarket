generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  FLAGGED
  REJECTED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum KycStatus {
  NOT_STARTED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

model University {
  id              String   @id @default(uuid())
  domain          String   @unique
  name            String
  countryCode     String
  region          String
  isAlumniEnabled Boolean  @default(false)
  users           User[]
  faculties       Faculty[]
}

model Faculty {
  id           String       @id @default(uuid())
  universityId String
  name         String
  slug         String       @unique
  university   University   @relation(fields: [universityId], references: [id])
  courses      LocalCourse[]
}

model LocalCourse {
  id              String   @id @default(uuid())
  facultyId       String
  courseCode      String
  name            String
  semesterOffered String
  year            Int
  faculty         Faculty  @relation(fields: [facultyId], references: [id])
  documents       ContentAsset[]
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String
  firstName          String
  lastName           String
  universityId       String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  mfaEnabled         Boolean  @default(false)
  lastLoginIp        String?
  role               String   @default("student")
  university         University? @relation(fields: [universityId], references: [id])
  sellerProfile      SellerProfile?
  transactions       PaymentTransaction[] @relation("BuyerTransactions")
  reviews            Review[] @relation("Reviewer")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SellerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  kycStatus        KycStatus @default(NOT_STARTED)
  stripeAccountId  String?  @unique
  availableBalance Int      @default(0)
  pendingBalance   Int      @default(0)
  lifetimeEarnings Int      @default(0)
  level            Int      @default(1)
  xpPoints         Int      @default(0)
  badges           String[] @default([])
  overallRating    Float    @default(0.0)
  user             User     @relation(fields: [userId], references: [id])
  assets           ContentAsset[]
  transactions     PaymentTransaction[] @relation("SellerTransactions")
}

model ContentAsset {
  id                     String   @id @default(uuid())
  sellerId               String
  localCourseId          String
  title                  String
  description            String
  format                 String
  status                 ContentStatus @default(DRAFT)
  fileUrl                String
  previewUrl             String?
  pageCount              Int      @default(1)
  priceAmount            Int
  currency               String   @default("ILS")
  isSubscriptionEligible Boolean  @default(false)
  viewCount              Int      @default(0)
  purchaseCount          Int      @default(0)
  compositeRating        Float    @default(0.0)
  seller                 SellerProfile @relation(fields: [sellerId], references: [id])
  course                 LocalCourse   @relation(fields: [localCourseId], references: [id])
  transactions           PaymentTransaction[]
  reviews                Review[]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model PaymentTransaction {
  id               String   @id @default(uuid())
  buyerId          String
  sellerId         String?
  contentId        String?
  grossAmount      Int
  platformFee      Int
  sellerCut        Int
  currency         String
  method           String
  status           TransactionStatus @default(PENDING)
  providerChargeId String?  @unique
  buyer            User          @relation("BuyerTransactions", fields: [buyerId], references: [id])
  seller           SellerProfile? @relation("SellerTransactions", fields: [sellerId], references: [id])
  content          ContentAsset? @relation(fields: [contentId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SubscriptionAccess {
  id                     String   @id @default(uuid())
  userId                 String
  tier                   String
  status                 String   @default("ACTIVE")
  providerSubscriptionId String?
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Review {
  id         String       @id @default(uuid())
  contentId  String
  reviewerId String
  rating     Int
  comment    String?
  createdAt  DateTime     @default(now())
  content    ContentAsset @relation(fields: [contentId], references: [id])
  reviewer   User         @relation("Reviewer", fields: [reviewerId], references: [id])
}